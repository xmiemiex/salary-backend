# Template only. Copy to /opt/salary-settlement-admin/shared/.env on the server,
# restrict permissions, and replace every angle-bracket placeholder there.
# Never commit the populated file.

NODE_ENV=production
APP_ENV=production
API_PORT=3000
PORT=3000
DATABASE_URL=<set-on-server-only>
CORS_ALLOWED_ORIGIN=https://admin-salary.lovemiemie.com
ADMIN_SESSION_TTL_SECONDS=43200
API_CREDENTIAL_ENCRYPTION_KEY=<set-on-server-only>

# Release/build metadata consumed by existing health reporting or Compose.
BUILD_TIMESTAMP=<set-by-release-process>
RELEASE_IMAGE_TAG=<immutable-tag-for-approved-commit>
VITE_API_BASE_URL=https://api-salary.lovemiemie.com
PRODUCTION_ENV_FILE=/opt/salary-settlement-admin/shared/.env

# Existing scheduler gates. Keep both explicit; enabling either needs release review.
SYNC_PLANNER_ENABLED=false
SYNC_PLANNER_DAY=10
SYNC_PLANNER_HOUR=9
SYNC_PLANNER_TIMEZONE=Asia/Shanghai
SYNC_AUTO_EXECUTION_ENABLED=false
SYNC_AUTO_EXECUTION_POLL_SECONDS=60
SYNC_AUTO_EXECUTION_BATCH_SIZE=2
SYNC_AUTO_EXECUTION_MAX_ATTEMPTS=3
SYNC_AUTO_EXECUTION_LEASE_SECONDS=900
SYNC_AUTO_EXECUTION_RETRY_BASE_SECONDS=300

# Requested contract names below are NOT read by the current application and must
# not be treated as active controls. They remain commented until code implements them.
# SESSION_SECRET=<not-used-currently>
# JWT_SECRET=<not-used-currently>
# AUDIT_EXPORT_ENABLED=<not-used-currently-fixed-behavior>
# AUDIT_EXPORT_MAX_ROWS=<not-used-currently-fixed-at-10000>
# RELEASE_GATE_ENABLED=<not-used-currently>
# LOG_LEVEL=<not-used-currently>
# BACKUP_POLICY=<documented-in-runbook-not-an-app-variable>
