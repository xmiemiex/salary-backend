#!/usr/bin/env bash
set -Eeuo pipefail

export LC_ALL=C
umask 077

active_key='/etc/salary-settlement-admin/backup-file-encryption.key'
active_metadata='/etc/salary-settlement-admin/backup-file-encryption.key.meta'
recovery_dir='/var/lib/salary-settlement-admin-key-recovery'
recovery_key="${recovery_dir}/backup-file-encryption.key"
recovery_metadata="${recovery_dir}/backup-file-encryption.key.meta"
crypto_tool='/usr/local/libexec/salary-settlement-admin/backup-file-crypto.mjs'
backup_dir='/opt/salary-settlement-admin/backups'
expected_owner='root'
expected_group='root'
recovery_purpose='salary-postgres-backup-key-recovery'
format='aes-256-gcm-v1'

active_exists='false'
active_valid='false'
recovery_exists='false'
recovery_valid='false'
key_match='unknown'
decrypt_status='not_checked'
health_codes=()
created_at_override=''
create_key_temp=''
create_metadata_temp=''
drill_temp_dir=''
self_test_fixture=''
recovery_incomplete=0

cleanup() {
  if [[ -n "$create_key_temp" ]]; then
    case "$create_key_temp" in
      "$recovery_dir"/.backup-file-encryption.key.*.tmp) rm -f -- "$create_key_temp" ;;
    esac
  fi
  if [[ -n "$create_metadata_temp" ]]; then
    case "$create_metadata_temp" in
      "$recovery_dir"/.backup-file-encryption.key.meta.*.tmp) rm -f -- "$create_metadata_temp" ;;
    esac
  fi
  if [[ -n "$drill_temp_dir" ]]; then
    case "$drill_temp_dir" in
      /run/task94-*) rm -rf -- "$drill_temp_dir" ;;
    esac
  fi
  if [[ -n "$self_test_fixture" ]]; then
    case "$(realpath -m -- "$self_test_fixture")" in
      /tmp/* | /var/tmp/*) rm -rf -- "$self_test_fixture" ;;
    esac
  fi
  if [[ "$recovery_incomplete" -eq 1 \
    && "$recovery_dir" == '/var/lib/salary-settlement-admin-key-recovery' ]]; then
    rm -f -- "$recovery_key" "$recovery_metadata"
  fi
}
trap cleanup EXIT

fail() {
  echo 'TASK94_KEY_RECOVERY_STATUS=failed'
  echo "TASK94_KEY_RECOVERY_ERROR=$1" >&2
  exit 1
}

join_codes() {
  local IFS=,
  printf '%s' "$*"
}

owner_group_mode() {
  stat -c '%U:%G:%a' -- "$1"
}

is_regular_private_file() {
  local path="$1"
  [[ -f "$path" && ! -L "$path" ]] || return 1
  [[ "$(owner_group_mode "$path")" == "${expected_owner}:${expected_group}:600" ]]
}

is_private_directory() {
  local path="$1"
  [[ -d "$path" && ! -L "$path" ]] || return 1
  [[ "$(owner_group_mode "$path")" == "${expected_owner}:${expected_group}:700" ]]
}

key_format_valid() {
  local path="$1"
  node "$crypto_tool" self-test --key-file "$path" >/dev/null 2>&1
}

active_metadata_valid() {
  is_regular_private_file "$active_metadata" || return 1
  [[ "$(wc -l <"$active_metadata")" -eq 1 ]] || return 1
  grep -qx 'purpose=salary-postgres-daily-backup;format=aes-256-gcm-v1' "$active_metadata"
}

metadata_value() {
  local name="$1"
  local path="$2"
  sed -n "s/^${name}=//p" "$path"
}

recovery_metadata_valid() {
  is_regular_private_file "$recovery_metadata" || return 1
  [[ "$(wc -l <"$recovery_metadata")" -eq 9 ]] || return 1
  local required=(
    format
    purpose
    created_at
    active_key_path
    recovery_key_path
    key_id
    active_key_owner_group_mode
    recovery_directory_owner_group_mode
    recovery_key_owner_group_mode
  )
  local field value
  for field in "${required[@]}"; do
    [[ "$(grep -c "^${field}=" "$recovery_metadata")" -eq 1 ]] || return 1
  done
  [[ "$(metadata_value format "$recovery_metadata")" == "$format" ]] || return 1
  [[ "$(metadata_value purpose "$recovery_metadata")" == "$recovery_purpose" ]] || return 1
  value="$(metadata_value created_at "$recovery_metadata")"
  [[ "$value" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || return 1
  [[ "$(metadata_value active_key_path "$recovery_metadata")" == "$active_key" ]] || return 1
  [[ "$(metadata_value recovery_key_path "$recovery_metadata")" == "$recovery_key" ]] || return 1
  value="$(metadata_value key_id "$recovery_metadata")"
  [[ "$value" =~ ^[a-f0-9]{16}$ ]] || return 1
  [[ "$(metadata_value active_key_owner_group_mode "$recovery_metadata")" == 'root:root:600' ]] || return 1
  [[ "$(metadata_value recovery_directory_owner_group_mode "$recovery_metadata")" == 'root:root:700' ]] || return 1
  [[ "$(metadata_value recovery_key_owner_group_mode "$recovery_metadata")" == 'root:root:600' ]] || return 1
}

key_id() {
  node "$crypto_tool" self-test --key-file "$1" |
    sed -n 's/^BACKUP_KEY_FINGERPRINT=//p'
}

assess() {
  local backup_path="${1:-}"
  active_exists='false'
  active_valid='false'
  recovery_exists='false'
  recovery_valid='false'
  key_match='unknown'
  decrypt_status='not_checked'
  health_codes=()

  if [[ -e "$active_key" || -L "$active_key" ]]; then
    active_exists='true'
    if is_regular_private_file "$active_key" \
      && [[ "$(stat -c '%h' -- "$active_key")" -eq 1 ]] \
      && active_metadata_valid \
      && key_format_valid "$active_key"; then
      active_valid='true'
    else
      health_codes+=('active_key_invalid')
    fi
  else
    health_codes+=('active_key_missing')
  fi

  if [[ -e "$recovery_key" || -L "$recovery_key" ]]; then
    recovery_exists='true'
    if is_private_directory "$recovery_dir" \
      && is_regular_private_file "$recovery_key" \
      && [[ "$(stat -c '%h' -- "$recovery_key")" -eq 1 ]] \
      && recovery_metadata_valid \
      && key_format_valid "$recovery_key"; then
      recovery_valid='true'
    else
      health_codes+=('recovery_key_invalid')
    fi
  else
    health_codes+=('recovery_key_missing')
  fi

  if [[ "$active_valid" == 'true' && "$recovery_valid" == 'true' ]]; then
    local active_identity recovery_identity active_id recovery_id
    active_identity="$(stat -c '%d:%i' -- "$active_key")"
    recovery_identity="$(stat -c '%d:%i' -- "$recovery_key")"
    active_id="$(key_id "$active_key")"
    recovery_id="$(key_id "$recovery_key")"
    if cmp -s -- "$active_key" "$recovery_key" \
      && [[ "$active_identity" != "$recovery_identity" ]] \
      && [[ "$active_id" == "$recovery_id" ]] \
      && [[ "$(metadata_value key_id "$recovery_metadata")" == "$active_id" ]]; then
      key_match='true'
    else
      key_match='false'
      health_codes+=('recovery_mismatch')
    fi
  fi

  if [[ -n "$backup_path" && "$recovery_valid" == 'true' ]]; then
    if [[ -f "$backup_path" && ! -L "$backup_path" ]] \
      && node "$crypto_tool" decrypt \
        --key-file "$recovery_key" \
        --input "$backup_path" \
        --output - 2>/dev/null |
        gzip -t 2>/dev/null; then
      decrypt_status='pass'
    else
      decrypt_status='fail'
      health_codes+=('recovery_decrypt_failed')
    fi
  fi
}

print_assessment() {
  echo 'TASK94_KEY_RECOVERY_STATUS=checked'
  echo "TASK94_ACTIVE_KEY_EXISTS=$active_exists"
  echo "TASK94_ACTIVE_KEY_VALID=$active_valid"
  echo "TASK94_RECOVERY_KEY_EXISTS=$recovery_exists"
  echo "TASK94_RECOVERY_KEY_VALID=$recovery_valid"
  echo "TASK94_KEY_MATCH=$key_match"
  echo "TASK94_RECOVERY_DECRYPT_STATUS=$decrypt_status"
  if [[ "${#health_codes[@]}" -eq 0 ]]; then
    echo 'TASK94_KEY_HEALTH_CODES=none'
  else
    echo "TASK94_KEY_HEALTH_CODES=$(join_codes "${health_codes[@]}")"
  fi
}

write_recovery_metadata() {
  local path="$1"
  local created_at="$2"
  local identifier="$3"
  {
    printf 'format=%s\n' "$format"
    printf 'purpose=%s\n' "$recovery_purpose"
    printf 'created_at=%s\n' "$created_at"
    printf 'active_key_path=%s\n' "$active_key"
    printf 'recovery_key_path=%s\n' "$recovery_key"
    printf 'key_id=%s\n' "$identifier"
    printf 'active_key_owner_group_mode=root:root:600\n'
    printf 'recovery_directory_owner_group_mode=root:root:700\n'
    printf 'recovery_key_owner_group_mode=root:root:600\n'
  } >"$path"
}

create_recovery() {
  [[ "$EUID" -eq 0 ]] || fail requires_root
  assess
  [[ "$active_valid" == 'true' ]] || fail active_key_invalid

  install -d -o root -g root -m 0700 "$recovery_dir"
  is_private_directory "$recovery_dir" || fail recovery_directory_invalid
  exec 8>"${recovery_dir}/.create.lock"
  flock -n 8 || fail recovery_creation_locked

  if [[ -e "$recovery_key" || -L "$recovery_key" || -e "$recovery_metadata" || -L "$recovery_metadata" ]]; then
    assess
    [[ "$recovery_valid" == 'true' && "$key_match" == 'true' ]] ||
      fail existing_recovery_invalid
    echo 'TASK94_KEY_RECOVERY_STATUS=reused'
    echo "TASK94_KEY_RECOVERY_PATH=$recovery_key"
    echo "TASK94_KEY_ID=$(key_id "$active_key")"
    return
  fi

  local created_at identifier
  create_key_temp="$(mktemp "${recovery_dir}/.backup-file-encryption.key.XXXXXXXX.tmp")"
  create_metadata_temp="$(mktemp "${recovery_dir}/.backup-file-encryption.key.meta.XXXXXXXX.tmp")"

  dd if="$active_key" of="$create_key_temp" status=none conv=fsync
  chown root:root "$create_key_temp"
  chmod 0600 "$create_key_temp"
  [[ -f "$create_key_temp" && ! -L "$create_key_temp" ]] || fail recovery_key_temp_invalid
  [[ "$(owner_group_mode "$create_key_temp")" == 'root:root:600' ]] || fail recovery_key_temp_permissions_invalid
  [[ "$(stat -c '%h' -- "$create_key_temp")" -eq 1 ]] || fail recovery_key_temp_hardlink
  [[ "$(stat -c '%d:%i' -- "$create_key_temp")" != "$(stat -c '%d:%i' -- "$active_key")" ]] ||
    fail recovery_key_temp_hardlink
  cmp -s -- "$active_key" "$create_key_temp" || fail recovery_key_temp_mismatch
  key_format_valid "$create_key_temp" || fail recovery_key_temp_format_invalid

  created_at="${created_at_override:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
  identifier="$(key_id "$active_key")"
  [[ "$identifier" =~ ^[a-f0-9]{16}$ ]] || fail key_id_invalid
  write_recovery_metadata "$create_metadata_temp" "$created_at" "$identifier"
  chown root:root "$create_metadata_temp"
  chmod 0600 "$create_metadata_temp"
  sync -f "$create_key_temp"
  sync -f "$create_metadata_temp"

  recovery_incomplete=1
  mv -T -- "$create_key_temp" "$recovery_key"
  create_key_temp=''
  mv -T -- "$create_metadata_temp" "$recovery_metadata"
  create_metadata_temp=''
  sync -f "$recovery_dir"

  assess
  [[ "$recovery_valid" == 'true' && "$key_match" == 'true' ]] ||
    fail recovery_post_create_validation_failed
  recovery_incomplete=0
  echo 'TASK94_KEY_RECOVERY_STATUS=created'
  echo "TASK94_KEY_RECOVERY_PATH=$recovery_key"
  echo "TASK94_KEY_ID=$identifier"
}

latest_backup() {
  find "$backup_dir" -maxdepth 1 -type f -name 'postgres-full-*.sql.gz.enc' \
    -printf '%T@ %p\n' |
    sort -nr |
    head -n 1 |
    cut -d' ' -f2-
}

run_drill() {
  [[ "$EUID" -eq 0 ]] || fail requires_root
  local backup_path
  backup_path="$(latest_backup)"
  [[ -n "$backup_path" ]] || fail latest_backup_missing
  assess "$backup_path"
  [[ "$active_valid" == 'true' ]] || fail active_key_invalid
  [[ "$recovery_valid" == 'true' ]] || fail recovery_key_invalid
  [[ "$key_match" == 'true' ]] || fail recovery_key_mismatch
  [[ "$decrypt_status" == 'pass' ]] || fail recovery_decrypt_precheck_failed

  local drill_stamp drill_id drill_dir drill_key active_before drill_started_at
  local auth_status='fail' gzip_status='fail' cleanup_status='complete'
  drill_stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  drill_id="task94-key-recovery-${drill_stamp}"
  drill_started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  drill_dir="$(mktemp -d "/run/task94-${drill_stamp}.XXXXXXXX")"
  drill_temp_dir="$drill_dir"
  drill_key="${drill_dir}/backup-file-encryption.key"
  chown root:root "$drill_dir"
  chmod 0700 "$drill_dir"
  active_before="$(stat -c '%d:%i:%s:%Y:%Z' -- "$active_key")"

  dd if="$recovery_key" of="$drill_key" status=none conv=fsync
  chown root:root "$drill_key"
  chmod 0600 "$drill_key"
  [[ "$(owner_group_mode "$drill_dir")" == 'root:root:700' ]] || fail drill_directory_permissions_invalid
  [[ -f "$drill_key" && ! -L "$drill_key" ]] || fail drill_key_invalid
  [[ "$(owner_group_mode "$drill_key")" == 'root:root:600' ]] || fail drill_key_permissions_invalid
  [[ "$(stat -c '%h' -- "$drill_key")" -eq 1 ]] || fail drill_key_hardlink
  cmp -s -- "$drill_key" "$active_key" || fail drill_key_mismatch

  set +e
  node "$crypto_tool" decrypt \
    --key-file "$drill_key" \
    --input "$backup_path" \
    --output - 2>/dev/null |
    gzip -t 2>/dev/null
  local pipeline_status=("${PIPESTATUS[@]}")
  set -e
  [[ "${pipeline_status[0]}" -eq 0 ]] && auth_status='pass'
  [[ "${pipeline_status[1]}" -eq 0 ]] && gzip_status='pass'
  [[ "$auth_status" == 'pass' && "$gzip_status" == 'pass' ]] ||
    fail drill_decrypt_or_gzip_failed
  [[ "$(stat -c '%d:%i:%s:%Y:%Z' -- "$active_key")" == "$active_before" ]] ||
    fail active_key_changed_during_drill

  rm -rf -- "$drill_dir" || cleanup_status='failed'
  drill_temp_dir=''
  [[ ! -e "$drill_dir" ]] || fail drill_cleanup_incomplete
  echo 'TASK94_RECOVERY_DRILL_STATUS=success'
  echo "TASK94_RECOVERY_DRILL_ID=$drill_id"
  echo "TASK94_RECOVERY_DRILL_STARTED_AT=$drill_started_at"
  echo "TASK94_RECOVERY_DRILL_BACKUP=$(basename -- "$backup_path")"
  echo "TASK94_RECOVERY_DRILL_AUTHENTICATION=$auth_status"
  echo "TASK94_RECOVERY_DRILL_GZIP=$gzip_status"
  echo "TASK94_RECOVERY_DRILL_CLEANUP=$cleanup_status"
  echo 'TASK94_RECOVERY_DRILL_ACTIVE_KEY_MODIFIED=no'
}

self_test() {
  local fixture fixture_user fixture_group plain backup
  fixture="$(mktemp -d)"
  self_test_fixture="$fixture"
  case "$(realpath -e "$fixture")" in
    /tmp/* | /var/tmp/*) ;;
    *) fail self_test_unsafe_fixture ;;
  esac
  local adjacent_crypto
  adjacent_crypto="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/backup-file-crypto.mjs"
  if [[ -f "$adjacent_crypto" ]]; then
    crypto_tool="$adjacent_crypto"
  fi
  [[ -f "$crypto_tool" ]] || fail self_test_crypto_tool_missing
  active_key="${fixture}/active.key"
  active_metadata="${fixture}/active.key.meta"
  recovery_dir="${fixture}/recovery"
  recovery_key="${recovery_dir}/backup-file-encryption.key"
  recovery_metadata="${recovery_dir}/backup-file-encryption.key.meta"
  backup_dir="${fixture}/backups"
  fixture_user="$(stat -c '%U' "$fixture")"
  fixture_group="$(stat -c '%G' "$fixture")"
  expected_owner="$fixture_user"
  expected_group="$fixture_group"
  install -d -m 0700 "$recovery_dir" "$backup_dir"
  node "$crypto_tool" generate-key --key-file "$active_key" >/dev/null
  chmod 0600 "$active_key"
  printf '%s\n' 'purpose=salary-postgres-daily-backup;format=aes-256-gcm-v1' >"$active_metadata"
  chmod 0600 "$active_metadata"
  cp -- "$active_key" "$recovery_key"
  chmod 0600 "$recovery_key"
  created_at_override='2026-07-30T00:00:00Z'
  write_recovery_metadata "$recovery_metadata" "$created_at_override" "$(key_id "$active_key")"
  chmod 0600 "$recovery_metadata"
  plain="${fixture}/fixture.sql.gz"
  backup="${backup_dir}/postgres-full-20260730T000000Z.sql.gz.enc"
  printf 'task94 fixture\n' | gzip -c >"$plain"
  node "$crypto_tool" encrypt --key-file "$active_key" --input "$plain" --output "$backup"

  assess "$backup"
  [[ "${#health_codes[@]}" -eq 0 && "$decrypt_status" == 'pass' ]] ||
    fail self_test_healthy_failed

  mv "$active_key" "${active_key}.hold"
  assess "$backup"
  [[ "$(join_codes "${health_codes[@]}")" == *active_key_missing* ]] || fail self_test_active_missing_failed
  mv "${active_key}.hold" "$active_key"

  chmod 0644 "$active_key"
  assess "$backup"
  [[ "$(join_codes "${health_codes[@]}")" == *active_key_invalid* ]] || fail self_test_active_permissions_failed
  chmod 0600 "$active_key"

  mv "$recovery_key" "${recovery_key}.hold"
  assess "$backup"
  [[ "$(join_codes "${health_codes[@]}")" == *recovery_key_missing* ]] || fail self_test_recovery_missing_failed
  mv "${recovery_key}.hold" "$recovery_key"

  chmod 0644 "$recovery_key"
  assess "$backup"
  [[ "$(join_codes "${health_codes[@]}")" == *recovery_key_invalid* ]] || fail self_test_recovery_permissions_failed
  chmod 0600 "$recovery_key"

  cp -- "$recovery_key" "${recovery_key}.good"
  rm -f -- "$recovery_key"
  node "$crypto_tool" generate-key --key-file "$recovery_key" >/dev/null
  chmod 0600 "$recovery_key"
  assess "$backup"
  [[ "$(join_codes "${health_codes[@]}")" == *recovery_mismatch* ]] || fail self_test_mismatch_failed
  rm -f -- "$recovery_key"
  mv "${recovery_key}.good" "$recovery_key"

  cp -- "$backup" "${backup}.tampered"
  printf '\001' >>"${backup}.tampered"
  assess "${backup}.tampered"
  [[ "$(join_codes "${health_codes[@]}")" == *recovery_decrypt_failed* ]] ||
    fail self_test_decrypt_failure_failed

  assess "$backup"
  [[ "${#health_codes[@]}" -eq 0 && "$active_valid" == 'true' \
    && "$recovery_valid" == 'true' && "$key_match" == 'true' \
    && "$decrypt_status" == 'pass' ]] || fail self_test_recovery_failed
  rm -rf -- "$fixture"
  self_test_fixture=''
  echo 'TASK94_KEY_RECOVERY_SELF_TEST=pass'
}

case "${1:-}" in
  check)
    [[ "$#" -le 2 ]] || fail invalid_arguments
    [[ "$EUID" -eq 0 ]] || fail requires_root
    assess "${2:-}"
    print_assessment
    ;;
  create)
    [[ "$#" -eq 1 ]] || fail invalid_arguments
    create_recovery
    ;;
  drill)
    [[ "$#" -eq 1 ]] || fail invalid_arguments
    run_drill
    ;;
  --self-test)
    [[ "$#" -eq 1 ]] || fail invalid_arguments
    self_test
    ;;
  *)
    fail invalid_arguments
    ;;
esac
