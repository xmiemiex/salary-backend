# Production candidate for rc-20260712-2.
# Certificate placeholders are rendered on the server; certificate material is never copied.

upstream salary_web {
    server 127.0.0.1:8080;
    keepalive 16;
}

upstream salary_api {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    access_log off;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name admin-salary.lovemiemie.com;
    return 301 https://$host$request_uri;
}

server {
    listen 80;
    listen [::]:80;
    server_name api-salary.lovemiemie.com;
    return 301 https://$host$request_uri;
}

server {
    listen [::]:443 ssl ipv6only=on;
    listen 443 ssl;
    server_name admin-salary.lovemiemie.com;

    ssl_certificate <CERTIFICATE_FULLCHAIN_PATH>;
    ssl_certificate_key <CERTIFICATE_PRIVATE_KEY_PATH>;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://salary_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_intercept_errors on;
        error_page 502 503 504 = @not_deployed;
    }

    location @not_deployed {
        default_type text/plain;
        add_header Retry-After 60 always;
        return 503 "Application is not deployed.\n";
    }
}

server {
    listen [::]:443 ssl;
    listen 443 ssl;
    server_name api-salary.lovemiemie.com;

    ssl_certificate <CERTIFICATE_FULLCHAIN_PATH>;
    ssl_certificate_key <CERTIFICATE_PRIVATE_KEY_PATH>;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    client_max_body_size 10m;

    location / {
        proxy_pass http://salary_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_intercept_errors on;
        error_page 502 503 504 = @not_deployed;
    }

    location @not_deployed {
        default_type application/json;
        add_header Retry-After 60 always;
        return 503 '{"status":"not_deployed"}';
    }
}
