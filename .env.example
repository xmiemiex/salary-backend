# Local PostgreSQL defaults used by compose.yaml. Change them for your machine if needed.
POSTGRES_PORT=5432
POSTGRES_USER=salary_dev
POSTGRES_PASSWORD=salary_dev_only
POSTGRES_DB=salary_settlement
DATABASE_URL="postgresql://salary_dev:salary_dev_only@localhost:5432/salary_settlement?schema=public"

API_PORT=3000
WEB_PORT=5173
VITE_API_BASE_URL="http://localhost:3000"
CORS_ALLOWED_ORIGIN="http://localhost:5173"
ADMIN_SESSION_TTL_SECONDS=43200

# Required. Generate a base64-encoded 32-byte key in PowerShell:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Replace the placeholder before starting the API. Never commit the generated value.
API_CREDENTIAL_ENCRYPTION_KEY="<GENERATE_A_RANDOM_32_BYTE_BASE64_KEY>"

# Monthly sync task planner. It only creates pending tasks; it never executes sync adapters.
# Production must explicitly set SYNC_PLANNER_ENABLED=true to enable it.
SYNC_PLANNER_ENABLED=false
SYNC_PLANNER_DAY=10
SYNC_PLANNER_HOUR=9
SYNC_PLANNER_TIMEZONE=Asia/Shanghai

# Automatic execution is separately gated and disabled unless explicitly enabled.
SYNC_AUTO_EXECUTION_ENABLED=false
SYNC_AUTO_EXECUTION_POLL_SECONDS=60
SYNC_AUTO_EXECUTION_BATCH_SIZE=2
SYNC_AUTO_EXECUTION_MAX_ATTEMPTS=3
SYNC_AUTO_EXECUTION_LEASE_SECONDS=900
SYNC_AUTO_EXECUTION_RETRY_BASE_SECONDS=300
